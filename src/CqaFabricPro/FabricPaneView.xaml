<UserControl x:Class="CqaFabricPro.FabricPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="300">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
      <TextBlock Text="Add Fabric Tiles" FontSize="14" FontWeight="Normal" HorizontalAlignment="Center" Margin="0,0,0,12" />
      <TextBlock Text="Use the separate Log In button before adding layers." TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,14" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,18" />
      <Separator />
      <TextBlock Text="Fabric selection" FontWeight="SemiBold" Margin="0,16,0,8" />
      <TextBlock Text="Vintage" />
      <ComboBox ItemsSource="{Binding Vintages}" SelectedItem="{Binding SelectedVintage}" Margin="0,4,0,10" />
      <TextBlock Text="Layer" />
      <ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" Margin="0,4,0,14" />
      <Button Content="Add Selected Layer to Map" Command="{Binding AddLayerCommand}"
              HorizontalAlignment="Left" MinWidth="190" Margin="0,0,0,14" />
      <TextBlock Text="{Binding AppVersion}" HorizontalAlignment="Right" Foreground="Gray" Margin="0,14,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
